{
	"name": "solidifront",
	"private": false,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "biome ci .",
		"typecheck": "turbo typecheck --filter=!@solidifront/start",
		"test": "vitest run",
		"format": "biome check --write . && prettier --write \"**/*.md\"",
		"version-packages": "changeset version",
		"release": "turbo build && changeset publish",
		"prepare": "effect-tsgo patch --typescript --no-oxlint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@changesets/cli": "^2.27.9",
		"@effect/tsgo": "0.36.4",
		"@effect/vitest": "4.0.0-rc.109",
		"@types/node": "^22.7.4",
		"effect": "4.0.0-rc.109",
		"prettier": "^3.3.3",
		"turbo": "^2.1.2",
		"turbo-ignore": "^2.1.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"dts-bundle-generator>typescript": "5.9.3"
		}
	},
	"packageManager": "pnpm@9.1.2",
	"engines": {
		"node": ">=18"
	}
}
